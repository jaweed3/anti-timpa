SERVER_HOST=0.0.0.0
SERVER_PORT=8000
RATE_LIMIT_PER_MINUTE=30

# LLM Provider (default: OpenCode Zen — https://opencode.ai/zen/v1)
# Bisa diganti ke NaraRouter/provider OpenAI-compatible lain.
NARA_ROUTER_API=sk-xxxx-your-api-key-here
NARA_BASE_URL=https://opencode.ai/zen/v1
NARA_MODEL=deepseek-v4-flash-free

# Search engine: google or duckduckgo
SEARCH_ENGINE=duckduckgo
